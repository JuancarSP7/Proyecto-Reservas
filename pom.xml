<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM = Project Object Model.
    Es el fichero de configuración de Maven. Le dice:
      · cómo se llama y qué versión tiene el proyecto
      · qué librerías (dependencias) necesita y de dónde descargarlas
      · cómo compilarlo y empaquetarlo
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<!-- Versión del formato del POM. Siempre es 4.0.0 en Maven 3. -->
	<modelVersion>4.0.0</modelVersion>

	<!--
	    PADRE DEL PROYECTO.
	    Nuestro proyecto "hereda" la configuración de spring-boot-starter-parent:
	      · las versiones de cientos de librerías que funcionan bien juntas
	        (por eso nuestras dependencias NO llevan <version>)
	      · la configuración por defecto de los plugins (compilar, empaquetar...)
	    Cambiando este número actualizamos Spring Boot entero.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/> <!-- busca el padre en el repositorio de Maven, no en una carpeta local -->
	</parent>

	<!--
	    IDENTIDAD DEL PROYECTO (sus "coordenadas" en Maven).
	      groupId    → organización o dominio al revés (com.portfolio)
	      artifactId → nombre del proyecto
	      version    → versión actual. SNAPSHOT = "en desarrollo, todavía no es definitiva"
	-->
	<groupId>com.portfolio</groupId>
	<artifactId>aplicacion-reservas</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<!-- Nombre y descripción legibles del proyecto -->
	<name>aplicacion-reservas</name>
	<description>Aplicación de reservas de actividades deportivas con Spring Boot</description>

	<!--
	    PROPIEDADES: variables que se usan en el resto del POM.
	    java.version → versión de Java con la que se compila el proyecto.
	-->
	<properties>
		<java.version>21</java.version>
	</properties>

	<!--
	    DEPENDENCIAS: las librerías que usa el proyecto.
	    Maven las descarga de internet (Maven Central) y las guarda en
	    C:\Users\jcsan\.m2\repository para no descargarlas otra vez.

	    Los "starters" de Spring Boot son paquetes que traen de golpe
	    todo lo necesario para una funcionalidad.

	    <scope> indica CUÁNDO se usa la dependencia:
	      (sin scope) → siempre: al compilar y al ejecutar
	      runtime     → solo al ejecutar, no hace falta para compilar
	      test        → solo para los tests, no va en la aplicación final
	-->
	<dependencies>

		<!-- ======================= DEPENDENCIAS PRINCIPALES ======================= -->

		<!--
		    Spring Web MVC: para crear la API REST.
		    Incluye los @RestController, la conversión a JSON (Jackson)
		    y el servidor Tomcat integrado (el que arranca en el puerto 8080).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
		    Spring Data JPA: acceso a la base de datos con entidades y repositorios.
		    Incluye Hibernate (el que convierte las entidades en tablas y consultas SQL)
		    y los JpaRepository (save, findById, findByEmail...).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
		    Validation: las anotaciones @NotBlank, @Email, @Size...
		    Comprueban que los datos que llegan a la API son correctos.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
		    Flyway: ejecuta los scripts SQL de src/main/resources/db/migration
		    (V1, V2, V3...) al arrancar la aplicación.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>

		<!-- Módulo de Flyway específico para PostgreSQL (lo necesita para hablar con Postgres) -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!--
		    Driver de PostgreSQL: el "traductor" que permite a Java conectarse a Postgres.
		    scope runtime → nuestro código no lo usa directamente, solo hace falta al ejecutar.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Spring Security Crypto: SOLO la parte de Spring Security que cifra contraseñas (BCrypt).
		    No activa el login ni bloquea endpoints: eso llegará en la fase de seguridad.
		    No lleva versión porque la gestiona el padre (spring-boot-starter-parent).
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!--
		    Lombok: genera código repetitivo al compilar (@Getter, @Setter,
		    @NoArgsConstructor, @RequiredArgsConstructor...).
		    optional true → no se "contagia" a otros proyectos que dependan de este.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
		    DevTools: reinicia la app automáticamente al cambiar el código (solo en desarrollo).
		    scope runtime + optional → NO se incluye en el .jar final que se despliega.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- ======================= DEPENDENCIAS DE TEST ======================= -->
		<!--
		    En Spring Boot 4 cada módulo tiene su propio "starter de test".
		    Todos incluyen JUnit 5, Mockito y AssertJ, más las utilidades
		    para probar su parte concreta.
		-->

		<!-- Tests de la capa web: probar controllers simulando peticiones HTTP (MockMvc) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Tests de repositorios JPA contra una base de datos (@DataJpaTest) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Tests de las validaciones (@NotBlank, @Email...) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Tests de las migraciones de Flyway -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
	    BUILD: cómo se compila y empaqueta el proyecto.
	    Los plugins son "herramientas" que Maven ejecuta en cada fase
	    (compile → test → package...).
	-->
	<build>
		<plugins>

			<!--
			    Plugin de Spring Boot:
			      · "mvnw package" genera un .jar EJECUTABLE con todo dentro
			        (se arranca con: java -jar aplicacion-reservas.jar).
			        Es el que meteremos en Docker.
			      · permite arrancar la app con "mvnw spring-boot:run"
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
			    Plugin del compilador de Java.
			    Lo configuramos para que use Lombok como "procesador de anotaciones":
			    al compilar, Lombok lee @Getter, @Setter... y genera ese código.
			    Sin esto, el código compilaría en IntelliJ pero podría fallar con Maven.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>

					<!-- Compilación del código principal (src/main/java) -->
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>

					<!-- Compilación de los tests (src/test/java) -->
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>